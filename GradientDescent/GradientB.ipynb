    }
   },
   "source": [
    "X = [1, 2, 3]\n",
    "y = [3, 5, 7]\n",
    "w,b = 0,0\n",
    "y_pred = [w*X[i] + b for i in range(len(X))]\n",
    "print(y_pred)\n",
    "g_b = 0\n",
    "for i in range(len(X)):\n",
    "    g_b += (y_pred[i]-y[i])\n",
    "g_b = 2/len(X)*g_b\n",
    "print(g_b)"
   ],
